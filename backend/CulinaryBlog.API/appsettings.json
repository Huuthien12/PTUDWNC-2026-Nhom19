{
  "Cache": {
    "RecipeDetail": { "Enabled": true }
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "CulinaryBlog.API",
    "Audience": "CulinaryBlog.Client",
    "ExpirationMinutes": 15
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": ""
    }
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "culinary-blog",
    "PublicBaseUrl": "",
    "UseSsl": false
  },
  "Email": {
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "From": "noreply@culinaryblog.local",
      "EnableSsl": false
    }
  },
  "PasswordReset": {
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
